NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prisma/Supabase database URL components. The config builds transaction-mode
# runtime and session-mode migration URLs from these values.
DB_USERNAME=app_runtime
DB_PASSWORD=replace_with_your_raw_database_password

# Optional URL-component overrides.
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_DB_REGION=us-west-2
# SUPABASE_DB_BASE_DOMAIN=supabase.com
# DB_NAME=postgres

# Optional full-URL overrides for custom deployments or credential rotation.
# DATABASE_URL=postgresql://your-runtime-pooler-url
# DIRECT_URL=postgresql://your-session-mode-migration-url

TMDB_API_READ_ACCESS_TOKEN=your-server-side-tmdb-read-token
# TMDB_API_KEY=your-server-side-tmdb-api-key
# TMDB_API_URL=https://api.themoviedb.org/3
# WATCHBOXD_API_URL=https://watchboxd.vercel.app

# Server-only key for LLM requests. The model is selected by the caller.
OPENAI_API_KEY=your-openai-api-key
